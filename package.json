{
  "name": "dnd-voices",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/worker.mjs --packages=external",
    "test:e2e:docker": "docker compose -f docker-compose.e2e.yml up -d --build --wait && E2E_BASE_URL=http://localhost:3002 playwright test",
    "test:e2e:ratelimit": "ANTHROPIC_API_KEY=e2e-placeholder ELEVENLABS_API_KEY=e2e-placeholder docker compose -f docker-compose.ratelimit.yml up -d --build --wait --force-recreate web && RATE_LIMIT_BASE_URL=http://localhost:3001 RATE_LIMIT_MAX=5 playwright test --project=rate-limit",
    "pauses:refresh": "tsx --env-file=.env scripts/refresh-pauses.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@better-auth/prisma-adapter": "^1.6.25",
    "@elevenlabs/elevenlabs-js": "^2.60.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.25",
    "bullmq": "^6.0.2",
    "ioredis": "^6.0.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
