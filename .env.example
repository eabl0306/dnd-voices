# --- Base de datos / cola --------------------------------------------------
DATABASE_URL="postgresql://dndvoices:dndvoices@localhost:5432/dndvoices"
REDIS_URL="redis://localhost:6379"

# --- Auth ------------------------------------------------------------------
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL pública de la app. En desarrollo se deja vacía y cae a localhost sola.
# EN PRODUCCIÓN ES OBLIGATORIA y tiene que ser la URL https real: better-auth
# compara el Origin de cada alta y login contra ella, así que con el valor de
# desarrollo el formulario responde 403 aunque la página cargue.
#   BETTER_AUTH_URL="https://voces.bahoque.com"
BETTER_AUTH_URL=""

# --- IA --------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ELEVENLABS_API_KEY=""

# --- Almacenamiento de audio ------------------------------------------------
# Directorio local donde se guardan clips y mezclas finales.
STORAGE_DIR="./storage"

# --- Seguridad --------------------------------------------------------------
# Intentos de alta/login por minuto y por IP. Súbelo sólo para correr los e2e,
# donde todos los casos salen de la misma dirección.
AUTH_RATE_LIMIT_MAX="10"

# Correos que pueden crear cuenta, separados por comas o saltos de línea.
# Vacío = alta abierta a cualquiera: en una instancia publicada, déjalo con tu
# correo y el de tu mesa, o cualquiera que dé con la URL gastará tus créditos.
# Quitar a alguien de la lista no le echa: sólo impide altas nuevas.
SIGNUP_ALLOWLIST=""
